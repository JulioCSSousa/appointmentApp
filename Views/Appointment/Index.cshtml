@using System.Globalization
@using appointmentApp.Models.ViewModels
@using appointmentApp.Services.Utilities

@model AppointmentViewModel

@{
    ViewData["Title"] = "Agendamento";
 
}

@if(TempData["AppointmentExists"] !=  null){
        <div class="alert alert-danger">
            @TempData["AppointmentExistis"]
        </div>
    }
    
<form asp-action="Create" asp-controller="Appointment" method="post">
    <!-- Seleção de Serviço -->
    <div class="card mb-4 shadow-lg">
        <div class="card-body">
            <h5 class="card-title mb-3">🛠 Escolha um Serviço</h5>
            <select class="form-select" id="serviceSelect" name="SelectedServiceId" required>
                <option selected disabled>Selecione um serviço...</option>
                @foreach (var service in Model.Services)
                {
                    <option value="@service.ServiceId"
                            data-price="@service.Price"
                            data-duration="@service.Duration">
                            @service.ServiceName
                            
                    </option>
                }
            </select>

            <div id="serviceDetails" class="mt-3 p-2 border rounded bg-light text-dark">
                <p><strong>Preço:</strong> <span id="price">-</span></p>
                <p><strong>Duração:</strong> <span id="duration">-</span> minutos</p>
            </div>

            <input type="hidden" name="ServiceName" id="hiddenService">
            <input type="hidden" name="Price" id="hiddenPrice">
            <input type="hidden" name="Duration" id="hiddenDuration">
        </div>
    </div>

    <!-- Seleção de Horário -->
    <div class="card shadow-lg">
        <div class="card-body">
            <h5 class="card-title mb-3">⏰ Escolha um Horário</h5>
            <div class="table-responsive">
                <table class="table table-bordered text-center">
                    <thead class="table-dark">
                        <tr>
                            @foreach (var date in Model.HoursToSchedule.Keys)
                            {
                                <th>@date.ToString("dddd", new CultureInfo("pt-BR"))</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            @for (int i = 0; i < Model.HoursToSchedule.Count; i++)
                            {
                                var date = Model.HoursToSchedule.Keys.ElementAt(i);
                                var timeList = Model.HoursToSchedule[date];
                                bool isClosed = !Model.IsDayClosed[i];

                                <td class="@(isClosed ? "day-off" : "")">
                                    <select class="form-select time-select" data-day="@date" @(isClosed ? "disabled" : "")>
                                        <option selected value="">Selecione...</option>
                                        @if (!isClosed)
                                        {
                                            @foreach (var time in timeList)
                                            {
                                                <option value="@date.Add(time).ToString("yyyy-MM-dd HH:mm")">
                                                    @time.ToString(@"hh\:mm")
                                                </option>
                                            }
                                        }
                                    </select>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>

            <input type="hidden" name="SelectedDayAndHour" id="hiddenSelectedDayAndHour">
            <input type="hidden" name="ClientId" id="hiddenClientId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
        </div>
    </div>

    <!-- Botão de Agendar -->
    <div class="d-flex justify-content-end mt-4">
        <button type="submit" id="bookButton" class="btn btn-success btn-lg shadow" disabled>
            <i class="bi bi-calendar-check me-2"></i> Agendar Agora
        </button>
    </div>
</form>

<!-- Estilos -->
<style>
    .day-off {
        background-color: #f8d7da !important;
        color: #721c24 !important;
        opacity: 0.6;
        pointer-events: none;
    }
</style>

<!-- Scripts -->

    <script>
        // Obtendo os elementos do botão e campos ocultos
        const bookButton = document.getElementById("bookButton");
        const hiddenService = document.getElementById("hiddenService");
        const hiddenTime = document.getElementById("hiddenSelectedDayAndHour");

        // Função para verificar o preenchimento do formulário
        function checkFormCompletion() {
            // Se ambos o serviço e o horário estiverem selecionados, habilita o botão
            if (hiddenService.value && hiddenTime.value) {
                bookButton.disabled = false;
            } else {
                bookButton.disabled = true;
            }
        }

        // Monitorando mudanças na seleção do serviço
        document.getElementById("serviceSelect").addEventListener("change", function() {
            // Atualizar o valor do serviço no campo oculto
            var selectedOption = this.options[this.selectedIndex];
            hiddenService.value = selectedOption.value || "";

            // Atualizar os detalhes do serviço
            document.getElementById("price").innerText = selectedOption.getAttribute("data-price") || "-";
            document.getElementById("duration").innerText = selectedOption.getAttribute("data-duration") || "-";

            // Verificar se o formulário está completo
            checkFormCompletion();
        });

        // Monitorando mudanças nas seleções de horário
        document.querySelectorAll(".time-select").forEach(function(selectElement) {
            selectElement.addEventListener("change", function() {
                // Definindo o valor do horário selecionado no campo oculto
                hiddenTime.value = selectElement.value || "";

                // Verificar se o formulário está completo
                checkFormCompletion();
            });
        });

        // Inicializando o estado do botão quando a página carrega
        window.addEventListener('DOMContentLoaded', function() {
            checkFormCompletion();
        });
</script>


<script src="~/js/appointment.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
