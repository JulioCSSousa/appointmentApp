@model AppointmentAppMvc.Models.ViewModels.SuperAdmin.SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "Painel global";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Painel global</h1>
            <p class="text-muted mb-0">Visão geral dos tenants, lojas e planos ativos.</p>
        </div>
        <a asp-action="Create" class="btn btn-dark">
            <i class="bi bi-building-add me-1"></i> Novo tenant
        </a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Tenants</small><h2 class="fw-bold mb-0">@Model.Tenants.Count</h2></div></div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Lojas</small><h2 class="fw-bold mb-0">@Model.Tenants.Count</h2></div></div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Usuários vinculados</small><h2 class="fw-bold mb-0">@Model.Tenants.Sum(item => item.UserCount)</h2></div></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tenant</th>
                            <th>Loja</th>
                            <th>Plano</th>
                            <th>Status</th>
                            <th>Expiração</th>
                            <th>Usuários</th>
                            <th>Link público</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in Model.Tenants)
                        {
                            <tr>
                                <td><strong>@tenant.TenantName</strong><br /><small class="text-muted">@tenant.TenantSlug</small></td>
                                <td><strong>@tenant.StoreName</strong><br /><small class="text-muted">@tenant.StoreSlug</small></td>
                                <td><span class="badge text-bg-primary">@tenant.ActivePlan</span></td>
                                <td><span class="badge @(tenant.PlanStatus.Equals("Active", StringComparison.OrdinalIgnoreCase) ? "text-bg-success" : "text-bg-secondary")">@tenant.PlanStatus</span></td>
                                <td>@(tenant.PlanExpiresAt?.ToString("dd/MM/yyyy") ?? "Sem expiração")</td>
                                <td>@tenant.UserCount <small class="text-muted">(@tenant.WorkerCount profissionais / @tenant.ClientCount clientes)</small></td>
                                <td><a href="/loja/@tenant.StoreSlug/Appointment/Create" target="_blank" rel="noopener">Abrir loja</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
