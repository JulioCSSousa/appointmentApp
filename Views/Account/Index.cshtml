@using AppointmentAppMvc.Models.ViewModels.Account
@using appointmentApp.Models.ViewModels
@model IEnumerable<UserWithRolesViewModel>

@{
    ViewData["Title"] = "Gerenciar Usuários";
}

<div class="container-fluid py-4 px-lg-5" style="background-color: #f8fafc; min-height: 100vh;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <div>
            <a asp-action="IndexAdm" asp-controller="Home" class="btn btn-link text-decoration-none text-muted p-0 mb-2">
                <i class="bi bi-arrow-left"></i> Voltar ao Painel
            </a>
            <h2 class="fw-bold text-dark m-0">Gerenciar Usuários</h2>
            <p class="text-muted small">Controle de acessos e permissões da plataforma.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Register" class="btn btn-custom-indigo shadow-sm">
                <i class="bi bi-person-plus-fill me-2"></i>Novo Usuário
            </a>
            <a asp-action="AddRole" class="btn btn-outline-dark shadow-sm">
                <i class="bi bi-shield-lock me-2"></i>Adicionar Role
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4 rounded-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="searchTerm" class="form-control border-start-0 ps-0" placeholder="Buscar por nome, e-mail ou função...">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100">Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase fs-xs fw-bold text-muted">Usuário</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted">Contato</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted text-center">Função</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-muted text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-3 bg-indigo-soft text-indigo fw-bold">
                                            @user.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@user.Name</div>
                                            <div class="text-muted small">ID: @user.Id.ToString().Substring(0, 8)...</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-dark">@user.Email</div>
                                    <div class="text-muted small">@user.PhoneNumber</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(user.Role == "Admin" ? "bg-rose-soft text-rose" : "bg-indigo-soft text-indigo") px-3 py-2 rounded-pill">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a href="@Url.Action("Update", "Account", new { id = user.Id })" class="btn btn-sm btn-outline-secondary border-0">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger border-0" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal-@user.Id">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <div class="modal fade" id="confirmDeleteModal-@user.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">
                                        <div class="modal-body text-center p-5">
                                            <i class="bi bi-exclamation-circle text-danger display-1 mb-3"></i>
                                            <h4 class="fw-bold">Excluir Usuário?</h4>
                                            <p class="text-muted">Esta ação não pode ser desfeita. Você irá remover <b>@user.Name</b> do sistema.</p>
                                            <div class="d-flex justify-content-center gap-2 mt-4">
                                                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                                                <form method="post" action="@Url.Action("Delete", "Account", new { id = user.Id })">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger px-4">Sim, Excluir</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">Nenhum usuário encontrado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <nav aria-label="..." class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link shadow-sm rounded-start-pill px-3" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchTerm="@ViewBag.SearchTerm">Anterior</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link bg-white text-dark border-start-0 border-end-0 fw-bold">@ViewBag.CurrentPage / @ViewBag.TotalPages</span>
            </li>
            <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link shadow-sm rounded-end-pill px-3" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchTerm="@ViewBag.SearchTerm">Próxima</a>
            </li>
        </ul>
    </nav>
</div>

<style>
    :root {
        --indigo: #6366f1;
        --indigo-soft: #eef2ff;
        --rose: #f43f5e;
        --rose-soft: #fff1f2;
        --slate-900: #0f172a;
    }

    .fs-xs {
        font-size: 0.75rem;
    }

    .btn-custom-indigo {
        background-color: var(--indigo);
        color: white;
        border-radius: 10px;
        font-weight: 600;
        padding: 8px 20px;
    }

        .btn-custom-indigo:hover {
            background-color: #4f46e5;
            color: white;
        }

    .avatar-sm {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 1.1rem;
    }

    .bg-indigo-soft {
        background-color: var(--indigo-soft);
    }

    .text-indigo {
        color: var(--indigo);
    }

    .bg-rose-soft {
        background-color: var(--rose-soft);
    }

    .text-rose {
        color: var(--rose);
    }

    .table thead th {
        border-bottom: 1px solid #f1f5f9;
        letter-spacing: 0.05em;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }

    .page-link {
        color: var(--slate-900);
        border-color: #e2e8f0;
    }

    .page-item.disabled .page-link {
        background-color: #f8fafc;
    }
</style>