@using AppointmentAppMvc.Models.ViewModels.Account
@model UpdateUserViewModel

@{
    ViewData["Title"] = "Editar perfil";
}

<div class="container-fluid py-5 px-lg-5" style="background-color: #f8fafc; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 px-4 text-center">
                    <div class="avatar-sm mx-auto mb-3 bg-indigo-soft text-indigo rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-gear fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark m-0">Editar usuário</h3>
                    <p class="text-muted small">Altere o nome e as informações de contato.</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Update" method="post" autocomplete="on">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small text-uppercase">Nome completo</label>
                            <div class="input-group border rounded-3 overflow-hidden shadow-sm">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-person text-indigo"></i></span>
                                <input type="text" asp-for="Name" autocomplete="name" class="form-control border-0 bg-light py-2" placeholder="Nome do usuário" required />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small text-uppercase">E-mail corporativo</label>
                            <div class="input-group border rounded-3 overflow-hidden shadow-sm">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-envelope text-indigo"></i></span>
                                <input type="email" asp-for="Email" autocomplete="email" class="form-control border-0 bg-light py-2" placeholder="email@example.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-muted small text-uppercase">Telefone / WhatsApp</label>
                            <div class="input-group border rounded-3 overflow-hidden shadow-sm">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-whatsapp text-indigo"></i></span>
                                <input type="tel" asp-for="PhoneNumber" autocomplete="tel" class="form-control border-0 bg-light py-2" placeholder="(00) 00000-0000" required />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-indigo py-2 fw-bold rounded-3 shadow-sm">
                                <i class="bi bi-check2-all me-2"></i>Salvar alterações
                            </button>
                            <a asp-action="Index" class="btn btn-outline-light text-muted border-0 py-2 fw-semibold">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --indigo: #6366f1;
        --indigo-soft: #eef2ff;
        --slate-800: #1e293b;
    }

    .bg-indigo-soft {
        background-color: var(--indigo-soft);
    }

    .text-indigo {
        color: var(--indigo);
    }

    .btn-indigo {
        background-color: var(--indigo);
        color: white;
        transition: all 0.2s ease;
    }

        .btn-indigo:hover {
            background-color: #4f46e5;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

    .input-group:focus-within {
        border-color: var(--indigo) !important;
        ring: 2px solid var(--indigo-soft);
    }

    .form-control:focus {
        background-color: #fff;
        outline: none;
        box-shadow: none;
    }
</style>