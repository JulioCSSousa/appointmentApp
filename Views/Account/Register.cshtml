@using AppointmentAppMvc.Models.ViewModels.Account
@using AppointmentAppMvc.Models.ViewModels.Account
@model RegisterViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <h2 class="text-center mb-4">Cadastro</h2>
    <form asp-action="Register" method="post" class="needs-validation" autocomplete="on" novalidate>
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Nome</label>
            <input asp-for="Name" class="form-control" autocomplete="name" />
            <div class="text-danger">
                <span asp-validation-for="Name"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label">Telefone</label>
            <input asp-for="PhoneNumber" type="tel" class="form-control" autocomplete="tel" />
            <div class="text-danger">
                <span asp-validation-for="PhoneNumber"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">E-mail</label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
            <div class="text-danger">
                <span asp-validation-for="Email"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Senha</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
            <div class="text-danger">
                <span asp-validation-for="Password"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirme a senha</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <div class="text-danger">
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Cadastrar</button>
        </div>
    </form>
</div>