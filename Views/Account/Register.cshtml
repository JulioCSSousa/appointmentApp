@model appointmentApp.Models.ViewModels.RegisterViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <h2 class="text-center mb-4">Registrar</h2>
    <form asp-action="Register" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"> Nome</label>
            <input asp-for="Name" class="form-control" autocomplete="off" />
            <div class="text-danger">
                <span asp-validation-for="Name"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"> Número de Telefone</label>
            <input asp-for="PhoneNumber" class="form-control" autocomplete="off" />
            <div class="text-danger">
                <span asp-validation-for="PhoneNumber"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="off"/>
            <div class="text-danger">
                <span asp-validation-for="Email"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Senha</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="off" />
            <div class="text-danger">
                <span asp-validation-for="Password"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirmar password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="off" />
            <div class="text-danger">
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Registrar</button>
        </div>
    </form>
</div>
