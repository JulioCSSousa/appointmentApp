@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acesso Restrito - Administrador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --indigo: #6366f1;
            --indigo-dark: #4f46e5;
            --slate-900: #0f172a;
        }

        body {
            background-color: #f8fafc;
            background-image: radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.15) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(99, 102, 241, 0.1) 0px, transparent 50%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        .login-card {
            background-color: #ffffff;
            border-radius: 24px;
            padding: 3rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08);
            max-width: 440px;
            width: 100%;
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        .brand-logo {
            width: 60px;
            height: 60px;
            background-color: var(--indigo);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            color: white;
            font-size: 1.8rem;
            box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3);
        }

        .login-card h2 {
            color: var(--slate-900);
            font-weight: 800;
            letter-spacing: -0.025em;
            margin-bottom: 0.5rem;
            text-align: center;
        }

        .login-card p {
            color: #64748b;
            text-align: center;
            margin-bottom: 2rem;
            font-size: 0.95rem;
        }

        .form-label {
            font-weight: 600;
            color: #475569;
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
        }

        .input-group-text {
            background-color: #f8fafc;
            border-right: none;
            color: #94a3b8;
        }

        .form-control {
            border-left: none;
            background-color: #f8fafc;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            border-color: #e2e8f0;
        }

            .form-control:focus {
                background-color: #fff;
                border-color: var(--indigo);
                box-shadow: none;
            }

        .input-group:focus-within .input-group-text {
            border-color: var(--indigo);
            color: var(--indigo);
            background-color: #fff;
        }

        .btn-primary {
            background-color: var(--indigo);
            border: none;
            padding: 0.8rem;
            border-radius: 12px;
            font-weight: 700;
            transition: all 0.3s ease;
            margin-top: 1rem;
        }

            .btn-primary:hover {
                background-color: var(--indigo-dark);
                transform: translateY(-2px);
                box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.2);
            }

        .footer-links {
            display: flex;
            justify-content: space-between;
            margin-top: 1.5rem;
            font-size: 0.85rem;
        }

            .footer-links a {
                color: var(--indigo);
                text-decoration: none;
                font-weight: 600;
            }

                .footer-links a:hover {
                    color: var(--indigo-dark);
                    text-decoration: underline;
                }

        .error-msg {
            background-color: #fff1f2;
            color: #e11d48;
            padding: 0.75rem;
            border-radius: 12px;
            font-size: 0.85rem;
            margin-top: 1.5rem;
            text-align: center;
            border: 1px solid #ffe4e6;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand-logo">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h2>Acesso do Administrador</h2>
        <p>Informe suas credenciais para gerenciar a plataforma.</p>

        <form asp-action="Login" method="post" autocomplete="on">
            <div class="mb-3">
                <label for="phoneNumber" class="form-label">Telefone</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    <input type="tel" class="form-control" id="phoneNumber" name="PhoneNumber" autocomplete="tel" placeholder="(00) 00000-0000" required>
                </div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Senha</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control" id="password" name="Password" autocomplete="current-password" placeholder="••••••••" required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Entrar <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </form>

        <div class="footer-links">
            <a href="/Account/Register">Cadastrar</a>
            <a href="/Account/PasswordRecovery">Esqueci a senha</a>
        </div>

        @if (ViewData["InvalidLogin"] != null)
        {
            <div class="error-msg">
                <i class="bi bi-x-circle-fill me-2"></i> @ViewData["InvalidLogin"]
            </div>
        }
    </div>
</body>
</html>