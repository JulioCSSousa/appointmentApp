@{
    Layout = null;
    
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #4e73df, #1cc88a);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Arial', sans-serif;
        }

        .login-container {
            background-color: #fff;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            max-width: 400px;
            width: 100%;
        }

            .login-container h2 {
                color: #4e73df;
                margin-bottom: 20px;
                text-align: center;
            }

        .btn-primary {
            background-color: #4e73df;
            border-color: #4e73df;
        }

            .btn-primary:hover {
                background-color: #375a7f;
                border-color: #375a7f;
            }

        .form-control:focus {
            border-color: #4e73df;
            box-shadow: 0 0 5px rgba(78, 115, 223, 0.5);
        }

        .create-account {
            text-align: right;
            font-size: 0.9rem;
        }

            .create-account a {
                color: #1cc88a;
                text-decoration: none;
            }

                .create-account a:hover {
                    text-decoration: underline;
                }
        .forgot-password {
            text-align: right;
            font-size: 0.9rem;
        }

            .forgot-password a {
                color: #1cc88a;
                text-decoration: none;
            }

                .forgot-password a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="login-container">
        <h2>Admin Login</h2>
        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="Email" placeholder="Digite seu email" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Senha</label>
                <input type="password" class="form-control" id="password" name="Password" placeholder="Digite sua senha" required>
            </div>
            <div class="mb-0 create-account">
                <a href="/Account/Register">Criar Conta</a>
            </div>
            <div class="mb-0 forgot-password">
                <a href="/Account/PasswordRecovery">Esqueceu sua senha?</a>
            </div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>
        @if (ViewData["UnauthorizedMessage"] != null)
        {
            <div style="color: red">
                @ViewData["UnauthorizedMessage"]
            </div>
        }
    </div>
    <div>
    </div>
</body>
</html>
