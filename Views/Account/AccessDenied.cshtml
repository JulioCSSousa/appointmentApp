@{
    ViewData["Title"] = "Acesso negado";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow rounded-4 mx-auto" style="max-width: 560px;">
        <div class="card-body p-5">
            <h2 class="mb-3">Acesso negado</h2>
            <p class="text-muted mb-4">
                Sua conta não possui permissão para acessar esta página.
            </p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary">
                    Fazer um agendamento
                </a>
                <a asp-controller="Account" asp-action="ClientLogin" class="btn btn-outline-secondary">
                    Login do cliente
                </a>
            </div>
        </div>
    </div>
</div>