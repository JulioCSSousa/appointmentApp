@using AppointmentAppMvc.Models.ViewModels.WorkSchedule
@using appointmentApp.Models.Entities
@using appointmentApp.Models.ViewModels
@using appointmentApp.Services;
@using appointmentApp.Services.Utilities
@model IEnumerable<DayScheduleViewModel>

<div class="container-fluid py-4 px-lg-5" style="background-color: #f8fafc; min-height: 100vh;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <div>
            <a asp-action="IndexAdm" asp-controller="Home" class="btn btn-link text-decoration-none text-muted p-0 mb-2">
                <i class="bi bi-arrow-left"></i> Painel Administrativo
            </a>
            <h2 class="fw-bold text-dark m-0">Configuração de Escala</h2>
            <p class="text-muted small">Defina os dias e horários de atendimento da sua equipe.</p>
        </div>

        <div class="alert alert-indigo d-flex align-items-center mb-0 shadow-sm border-0 py-2 px-3">
            <i class="bi bi-info-circle-fill me-2 fs-5 text-indigo"></i>
            <span class="small text-indigo-emphasis">Configure um horário padrão para agilizar o preenchimento.</span>
        </div>
    </div>

    <form asp-action="SaveWorkSchedule" method="post">

        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
            <div class="card-body p-4">
                <h6 class="text-uppercase fw-bold text-muted small mb-3">Ajuste em Lote</h6>
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Horário Inicial Padrão</label>
                        <div class="input-group border rounded-3 overflow-hidden">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-clock"></i></span>
                            <input type="time" id="defaultStart" class="form-control border-0" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Horário Final Padrão</label>
                        <div class="input-group border rounded-3 overflow-hidden">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-clock-fill"></i></span>
                            <input type="time" id="defaultEnd" class="form-control border-0" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button type="button" id="applyDefault" class="btn btn-indigo-soft w-100 fw-bold py-2">
                            <i class="bi bi-magic me-2"></i>Aplicar a Todos
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="ps-4 py-3 fw-medium">Dia da Semana</th>
                            <th class="py-3 fw-medium text-center">Status de Trabalho</th>
                            <th class="py-3 fw-medium">Horário de Início</th>
                            <th class="py-3 fw-medium">Horário de Término</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Count(); i++)
                        {
                            var schedule = Model.ElementAt(i);
                            var isDisabled = !schedule.IsSelected;

                            <tr class="schedule-row @(isDisabled ? "bg-light-subtle opacity-75" : "")">
                                <td class="ps-4">
                                    <input type="hidden" name="models[@i].Day" value="@schedule.Day" />
                                    <span class="fw-bold text-dark">@DayOfWeekHelper.ToPortuguese(schedule.Day.DayOfWeek)</span>
                                </td>
                                <td>
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <input type="checkbox" id="@schedule.Id" class="form-check-input individual-day custom-switch"
                                               name="models[@i].IsSelected"
                                               value="true" @(schedule.IsSelected ? "checked" : "") />
                                    </div>
                                </td>
                                <td>
                                    <input type="time" class="form-control form-control-sm rounded-3 start-hour border-0 shadow-sm"
                                           name="models[@i].Start"
                                           value="@schedule.Start.ToString(@"hh\:mm")"
                                           @(isDisabled ? "disabled" : "") />
                                </td>
                                <td>
                                    <input type="time" class="form-control form-control-sm rounded-3 end-hour border-0 shadow-sm"
                                           name="models[@i].End"
                                           value="@schedule.End.ToString(@"hh\:mm")"
                                           @(isDisabled ? "disabled" : "") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="sticky-bottom py-3 mt-4 bg-white border-top shadow-lg mx-n4 px-4 rounded-top-4">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small d-none d-md-inline">Certifique-se de salvar antes de sair da página.</span>
                <button type="submit" id="savebtn" class="btn btn-dark px-5 py-2 fw-bold rounded-pill">
                    <i class="bi bi-cloud-check me-2"></i>Salvar Cronograma
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    :root {
        --indigo: #6366f1;
        --indigo-soft: #eef2ff;
        --slate-900: #0f172a;
    }

    /* Estilo para o Alert sutil */
    .alert-indigo {
        background-color: var(--indigo-soft);
        color: var(--indigo);
        border: 1px solid rgba(99, 102, 241, 0.2);
    }

    .btn-indigo-soft {
        background-color: var(--indigo-soft);
        color: var(--indigo);
        border: none;
    }

        .btn-indigo-soft:hover {
            background-color: var(--indigo);
            color: white;
        }

    /* Tabela */
    .schedule-row {
        transition: all 0.2s;
    }

    /* Inputs de tempo */
    .form-control[type="time"] {
        max-width: 150px;
        background-color: #f1f5f9;
    }

        .form-control[type="time"]:focus {
            background-color: white;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }

    /* Switch Customizado */
    .custom-switch {
        width: 3rem !important;
        height: 1.5rem !important;
        cursor: pointer;
    }

        .custom-switch:checked {
            background-color: var(--indigo);
            border-color: var(--indigo);
        }

    .is-invalid {
        border: 2px solid #f43f5e !important;
        box-shadow: 0 0 10px rgba(244, 63, 94, 0.2);
    }

    /* Sticky save bar */
    .sticky-bottom {
        position: sticky;
        bottom: 0;
        z-index: 1020;
    }
</style>