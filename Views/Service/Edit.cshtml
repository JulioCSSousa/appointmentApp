@using appointmentApp.Models.ViewModels

@model UpdateServiceViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

@if (TempData["AppointmentExists"] != null)
{
    <div class="alert alert-danger">
        @TempData["AppointmentExists"]
    </div>
}

<a asp-action="Index"
   class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50 transition duration-300">
    ⬅ Retornar
</a>
<div class="container mt-5 top-0 bottom-20">
    <h2 class="text-center mb-4">Editar Serviço</h2>
    <form asp-action="Edit" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="ServiceId" />
        <div class="mb-3">
            <label asp-for="ServiceName" class="form-label"> Nome Do Serviço</label>
            <input asp-for="ServiceName" class="form-control" required />

        </div>
        <div class="mb-3">
            <label asp-for="Price" class="form-label"> Preço </label>
            <input asp-for="Price" type="currency" class="form-control" required />

        </div>
        <div class="mb-3">
            <label asp-for="Duration" class="form-label">Duração</label>
            <input asp-for="Duration" class="form-control" />

        </div>
        <div class="mb-3">
            <label asp-for="Category" class="form-label">Categoria</label>
            <input asp-for="Category" class="form-control" autocomplete="off" />
        </div>

        <div class="d">
            <button type="submit" class="btn btn-primary">Registrar</button>
        </div>
    </form>
</div>

