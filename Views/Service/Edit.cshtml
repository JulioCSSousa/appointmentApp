@using AppointmentAppMvc.Models.ViewModels.Services
@using appointmentApp.Models.ViewModels

@model UpdateServiceViewModel

@{
    ViewData["Title"] = "Editar serviço";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    @if (TempData["AppointmentExists"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["AppointmentExists"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <a asp-action="Index" class="btn btn-outline-secondary mb-4">
        ⬅ Voltar
    </a>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h2 class="text-center mb-4 fw-bold">Editar serviço</h2>

        <!-- Formulário mapeado para Controller/Action com Antiforgery -->
        <form asp-controller="Service" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <!-- Mantém o ID do serviço para o POST -->
            <input type="hidden" asp-for="ServiceId" />

            <div class="mb-3">
                <label asp-for="ServiceName" class="form-label fw-semibold">Nome do serviço</label>
                <input asp-for="ServiceName" class="form-control" />
                <span asp-validation-for="ServiceName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-semibold">Preço</label>
                <!-- type="number" com step="0.01" para decimais -->
                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Duration" class="form-label fw-semibold">Duração</label>
                <input asp-for="Duration" class="form-control" />
                <span asp-validation-for="Duration" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label fw-semibold">Categoria</label>
                <input asp-for="Category" class="form-control" autocomplete="off" />
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary fw-bold py-2">Salvar alterações</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}