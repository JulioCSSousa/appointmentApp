@using AppointmentAppMvc.Models.ViewModels.Account
@using AppointmentAppMvc.Models.ViewModels.Services
@model CreateServiceViewModel

@{
    ViewData["Title"] = "Criar serviço";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    @if (TempData["durationExceed"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            @TempData["durationExceed"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <a asp-action="Index" class="btn btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left"></i> ⬅ Voltar
    </a>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h2 class="text-center mb-4 fw-bold">Novo serviço</h2>

        <form asp-controller="Service" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="ServiceName" class="form-label fw-semibold">Nome do serviço</label>
                <input asp-for="ServiceName" class="form-control" />
                <span asp-validation-for="ServiceName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-semibold">Preço</label>

                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Duration" class="form-label fw-semibold">Duração (ex.: 01:00:00 ou minutos)</label>
                <input asp-for="Duration" class="form-control" />
                <span asp-validation-for="Duration" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label fw-semibold">Categoria</label>
                <input asp-for="Category" class="form-control" autocomplete="off" />
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary fw-bold py-2">Cadastrar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <!-- Scripts de validação no lado do cliente (Client-side validation) -->
    <partial name="_ValidationScriptsPartial" />
}