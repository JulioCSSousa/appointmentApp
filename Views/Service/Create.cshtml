@using AppointmentAppMvc.Models.ViewModels.Account
@using AppointmentAppMvc.Models.ViewModels.Services
@model CreateServiceViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

@if (TempData["durationExceed"] != null)
{
    <div class="alert alert-danger">
        @TempData["durationExceed"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<a asp-action="Index"
   class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50 transition duration-300">
    ⬅ Back
</a>

<div class="container mt-5 top-0 bottom-20">
    <h2 class="text-center mb-4">New Service</h2>
    <form asp-action="Create" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
            <label asp-for="ServiceName" class="form-label">Service Name</label>
            <input asp-for="ServiceName" class="form-control" required />
            <div class="text-danger">
                <span asp-validation-for="ServiceName">This field is required</span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Price" class="form-label">Price</label>
            <input asp-for="Price" type="currency" class="form-control" required />
            <div class="text-danger">
                <span asp-validation-for="Price">This field is required</span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Duration" class="form-label">Duration</label>
            <input asp-for="Duration" class="form-control" />
            <div class="text-danger">
                <span asp-validation-for="Duration">This field is required</span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Category" class="form-label">Category</label>
            <input asp-for="Category" class="form-control" autocomplete="off" />
            <div class="text-danger">
                <span asp-validation-for="Category">This field is required</span>
            </div>
        </div>

        <div class="d">
            <button type="submit" class="btn btn-primary">Register</button>
        </div>
    </form>
</div>