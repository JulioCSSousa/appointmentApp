
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container my-4">
    <div class="text-center mb-6">
        <h1 class="display-4">Painel Administrativo</h1>
        <p class="lead">Gerencie usuários, agendamentos, clientes e financeiro de forma prática e rápida.</p>
    </div>

    <div class="row g-5">
        <!-- Controle de Usuários -->
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="icon mb-3">
                        <i class="bi bi-people fs-1 text-primary"></i>
                    </div>
                    <h5 class="card-title">Controle de Usuários</h5>
                    <p class="card-text">Gerencie permissões, roles e informações de usuários.</p>
                    <a asp-controller="Account" asp-action="Index" class="btn btn-primary">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Horários -->
        <div class="col-lg-4 col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="icon mb-3">
                        <i class="bi bi-calendar-check fs-1 text-success"></i>
                    </div>
                    <h5 class="card-title">Horários</h5>
                    <p class="card-text">Visualize e organize horários de agendamento e funcionamento.</p>
                    <a asp-controller="WorkSchedule" asp-action="SaveWorkSchedule" class="btn btn-success">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Serviços-->
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="icon mb-3">
                        <i class="bi bi-scissors fs-3 text-success"></i>
                    </div>
                    <h5 class="card-title">Serviços</h5>
                    <p class="card-text">Visualize e organize os Serviços ofertados.</p>
                    <a asp-controller="Service" asp-action="Index" class="btn btn-dark">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Clientes -->
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="icon mb-3">
                        <i class="bi bi-person-lines-fill fs-1 text-info"></i>
                    </div>
                    <h5 class="card-title">Clientes</h5>
                    <p class="card-text">Gerencie informações e histórico dos clientes.</p>
                    <a asp-controller="Client" asp-action="Index" class="btn btn-danger">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Financeiro -->
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="icon mb-3">
                        <i class="bi bi-currency-dollar fs-1 text-warning"></i>
                    </div>
                    <h5 class="card-title">Financeiro</h5>
                    <p class="card-text">Controle receitas, despesas e relatórios financeiros.</p>
                    <a asp-controller="Finance" asp-action="Index" class="btn btn-warning">Acessar</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .icon {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 80px;
        width: 80px;
        border-radius: 50%;
        background-color: #f8f9fa;
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

