                        <p class="mt-2 text-sm text-slate-400">
                            Preencha os dados da sua barbearia e fale diretamente com nossa equipe para liberar seu acesso de teste.
                        </p>

                        <form method="post" class="mt-6 space-y-4">
                            @Html.AntiForgeryToken()

                            <div>
                                <label for="NomeBarbearia" class="block text-xs font-semibold text-slate-300 mb-1.5">Nome da barbearia</label>
                                <input id="NomeBarbearia" name="NomeBarbearia" type="text" placeholder="Ex: Barbearia Navalha de Ouro"
                                       class="w-full bg-pitch-950 border border-pitch-700 focus:border-electric-500 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-colors" />
                            </div>

                            <div>
                                <label for="NomeResponsavel" class="block text-xs font-semibold text-slate-300 mb-1.5">Nome do responsável</label>
