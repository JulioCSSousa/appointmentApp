                                       class="w-full bg-pitch-950 border border-pitch-700 focus:border-electric-500 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-colors" />
                            </div>

                            <div class="grid sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="QuantidadeCadeiras" class="block text-xs font-semibold text-slate-300 mb-1.5">Quantidade de cadeiras</label>
                                    <select id="QuantidadeCadeiras" name="QuantidadeCadeiras"
                                            class="w-full bg-pitch-950 border border-pitch-700 focus:border-electric-500 rounded-xl px-4 py-3 text-sm text-white outline-none transition-colors">
                                        <option value="1 cadeira (Solo)">1 cadeira (Solo)</option>
                                        <option value="2 a 4 cadeiras">2 a 4 cadeiras</option>
                                        <option value="5 ou mais cadeiras">5 ou mais cadeiras</option>
                                    </select>
                                </div>

                                <div>
                                    <label for="PlanoInteresse" class="block text-xs font-semibold text-slate-300 mb-1.5">Plano de interesse</label>
                                    <select id="PlanoInteresse" name="PlanoInteresse"
                                            class="w-full bg-pitch-950 border border-pitch-700 focus:border-electric-500 rounded-xl px-4 py-3 text-sm text-white outline-none transition-colors">
                                        <option value="Barbeiro Solo (R$ 49/mês)">Barbeiro Solo (R$ 49/mês)</option>
                                        <option value="Barbearia Pro (R$ 89/mês)" selected>Barbearia Pro (R$ 89/mês)</option>
                                        <option value="Rede & Franquia (R$ 149/mês)">Rede &amp; Franquia (R$ 149/mês)</option>
                                    </select>
                                </div>
                            </div>

                            <button type="submit"
                                    class="w-full inline-flex justify-center items-center gap-2 bg-electric-600 hover:bg-electric-500 text-white font-bold py-4 px-6 rounded-xl transition-all blue-shadow cursor-pointer mt-2">
                                <i data-lucide="message-circle" class="w-5 h-5"></i>
                                Liberar Teste no WhatsApp
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </section>

