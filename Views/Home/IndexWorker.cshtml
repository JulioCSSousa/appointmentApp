@using AppointmentAppMvc.Models.ViewModels.Appointment
@using AppointmentAppMvc.Models.ViewModels.Get
@using appointmentApp.Services.Utilities
@model List<ClientIndexViewModel>
@{
    ViewData["Title"] = "Flow Management";
}
<h2 class="fw-bold m-0">Hello! @ViewBag.UserName</h2>
<div class="container-fluid py-4 px-lg-5" style="background-color: #f1f5f9; min-height: 100vh;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 gap-3">
        <div>
            <h2 class="fw-bold text-dark m-0"><i class="bi bi-layout-kanban me-2"></i>Operations Board</h2>
            <p class="text-muted">Manage today's and upcoming client flows.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index"
               asp-route-searchDate="@DateTime.Today.ToString("yyyy-MM-dd")"
               class="btn btn-white shadow-sm rounded-pill">
                <i class="bi bi-calendar-event me-2 text-primary"></i>Today
            </a>

            <a asp-action="Create"
               asp-controller="Appointment"
               class="btn btn-custom-indigo shadow-sm rounded-pill">
                <i class="bi bi-plus-lg me-2"></i>New Appointment
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-4">
            <div class="column-header mb-3 d-flex align-items-center">
                <span class="badge bg-amber me-2 p-2">@Model.Count(x => x.Appointment.Status == "Waiting")</span>
                <h5 class="fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Waiting</h5>
            </div>

            <div class="kanban-column">
                @foreach (var item in Model.Where(x => x.Appointment.Status == "Waiting").OrderBy(x => x.Appointment.Day))
                {
                    <div class="card mb-3 border-0 shadow-sm hover-card border-start border-4 border-warning">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-indigo-soft text-indigo rounded-pill">
                                    <i class="bi bi-clock me-1"></i> @item.Appointment.Day.ToString(@"HH\:mm")
                                </span>
                                <span class="text-muted small">@item.Appointment.Day.ToString("dd/MM")</span>
                            </div>

                            <h6 class="fw-bold text-dark mb-1">@item.User?.Name</h6>
                            <p class="text-muted small mb-3">@item.Service?.ServiceName</p>
                            <p class="text-muted small mb-3">Staff: @item.WorkerName</p>

                            <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-2">
                                <div class="btn-group w-100">
                                    <form asp-action="UpdateStatus" asp-controller="Appointment" method="post" class="w-100 me-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Appointment.Id" />
                                        <input type="hidden" name="newStatus" value="InProgress" />
                                        <button type="submit" class="btn btn-sm btn-emerald w-100 rounded-3 text-white fw-bold">
                                            Next
                                        </button>
                                    </form>
                                    <form asp-action="UpdateStatus" asp-controller="Appointment" method="post" class="w-100">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Appointment.Id" />
                                        <input type="hidden" name="newStatus" value="Canceled" />
                                        <button type="submit" class="btn btn-sm btn-outline-rose w-100 rounded-3 fw-bold">
                                            Cancel
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="column-header mb-3 d-flex align-items-center">
                <span class="badge bg-emerald me-2 p-2">@Model.Count(x => x.Appointment.Status == "InProgress")</span>
                <h5 class="fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">In Progress</h5>
            </div>
            <div class="kanban-column bg-light-soft rounded-3 p-2">
                @foreach (var item in Model.Where(x => x.Appointment.Status == "InProgress").OrderByDescending(x => x.Appointment.Day))
                {
                    <div class="card mb-3 border-0 shadow-sm hover-card border-start border-4 border-success">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-play-circle-fill text-success me-3 fs-4"></i>
                                <div class="flex-grow-1">
                                    <h6 class="text-dark mb-0 small fw-bold">@item.User?.Name</h6>
                                    <span class="text-muted" style="font-size: 0.7rem;">@item.Service?.ServiceName</span>
                                    <p class="text-muted small mb-3">Staff: @item.WorkerName</p>
                                </div>
                            </div>

                            <!-- BUTTON TO CHANGE STATUS TO "Finished" -->
                            <div class="border-top pt-3 mt-2">
                                <form asp-action="UpdateStatus" asp-controller="Appointment" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Appointment.Id" />
                                    <input type="hidden" name="newStatus" value="Finished" />
                                    <button type="submit" class="btn btn-sm btn-success w-100 rounded-3 text-white fw-bold">
                                        <i class="bi bi-check2 me-1"></i> Complete Service
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="column-header mb-3 d-flex align-items-center">
                <span class="badge bg-emerald me-2 p-2">@Model.Count(x => x.Appointment.Status == "Finished")</span>
                <h5 class="fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Completed</h5>
            </div>
            <div class="kanban-column bg-light-soft rounded-3 p-2">
                @foreach (var item in Model.Where(x => x.Appointment.Status == "Finished").OrderByDescending(x => x.Appointment.Day))
                {
                    <div class="card mb-2 border-0 shadow-sm opacity-75">
                        <div class="card-body p-3 py-2">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-check-circle-fill text-emerald me-3 fs-4"></i>
                                <div class="flex-grow-1">
                                    <h6 class="text-dark mb-0 small fw-bold">@item.User?.Name</h6>
                                    <span class="text-muted" style="font-size: 0.7rem;">@item.Service?.ServiceName</span>
                                    <p class="text-muted small mb-3">Staff: @item.WorkerName</p>
                                </div>
                                <span class="fw-bold text-dark small">@item.Service?.Price.ToString("C")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="column-header mb-3 d-flex align-items-center">
                <span class="badge bg-rose me-2 p-2">@Model.Count(x => x.Appointment.Status == "Canceled")</span>
                <h5 class="fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Canceled</h5>
            </div>
            <div class="kanban-column opacity-50">
                @foreach (var item in Model.Where(x => x.Appointment.Status == "Canceled"))
                {
                    <div class="card mb-2 border-0 p-2 shadow-sm">
                        <div class="flex-grow-1">
                            <h6 class="text-dark mb-0 small fw-bold">@item.User?.Name</h6>
                            <span class="text-muted" style="font-size: 0.7rem;">@item.Service?.ServiceName</span>
                            <p class="text-muted small mb-3">Staff: @item.WorkerName</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --indigo: #6366f1;
        --indigo-soft: #eef2ff;
        --emerald: #10b981;
        --rose: #f43f5e;
        --amber: #f59e0b;
    }

    .kanban-column {
        min-height: 70vh;
        max-height: 75vh;
        overflow-y: auto;
        padding-right: 5px;
    }

        /* Scrollbar Styling */
        .kanban-column::-webkit-scrollbar {
            width: 5px;
        }

        .kanban-column::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }

        .hover-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1) !important;
        }

    .btn-emerald {
        background-color: var(--emerald);
    }

        .btn-emerald:hover {
            background-color: #059669;
        }

    .btn-outline-rose {
        border: 1px solid var(--rose);
        color: var(--rose);
    }

        .btn-outline-rose:hover {
            background-color: var(--rose);
            color: white;
        }

    .bg-indigo-soft {
        background-color: var(--indigo-soft);
    }

    .text-indigo {
        color: var(--indigo);
    }

    .bg-light-soft {
        background-color: rgba(248, 250, 252, 0.5);
    }

    .btn-white {
        background: white;
        border: 1px solid #e2e8f0;
        font-weight: 600;
    }

    .btn-custom-indigo {
        background: var(--indigo);
        color: white;
        font-weight: 600;
    }
</style>