@{
    ViewData["Title"] = "Dashboard Financeiro";
}

<div class="container my-5">
    <h2 class="text-center mb-4">Dashboard Financeiro</h2>

    <!-- Resumo Financeiro -->
    <div class="row text-center mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5>Saldo Atual</h5>
                <h3 class="text-success">R$ 12.500,00</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5>Total de Receitas</h5>
                <h3 class="text-primary">R$ 25.000,00</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5>Total de Despesas</h5>
                <h3 class="text-danger">R$ 12.500,00</h3>
            </div>
        </div>
    </div>

    <!-- Gráfico Financeiro -->
    <div class="card p-4 shadow-sm mb-4">
        <h5 class="text-center">Gráfico Financeiro</h5>
        <canvas id="financeChart" height="100"></canvas>
    </div>

    <!-- Tabela de Transações -->
    <div class="card shadow-sm p-4">
        <h5 class="text-center">Últimas Transações</h5>
        <table class="table table-striped mt-3">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Descrição</th>
                    <th>Categoria</th>
                    <th>Valor</th>
                    <th>Tipo</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>22/02/2025</td>
                    <td>Pagamento Cliente A</td>
                    <td>Serviço</td>
                    <td class="text-success">+ R$ 3.000,00</td>
                    <td><span class="badge bg-primary">Receita</span></td>
                </tr>
                <tr>
                    <td>21/02/2025</td>
                    <td>Aluguel Escritório</td>
                    <td>Despesas Fixas</td>
                    <td class="text-danger">- R$ 2.500,00</td>
                    <td><span class="badge bg-danger">Despesa</span></td>
                </tr>
                <tr>
                    <td>20/02/2025</td>
                    <td>Venda Produto X</td>
                    <td>Produtos</td>
                    <td class="text-success">+ R$ 1.500,00</td>
                    <td><span class="badge bg-primary">Receita</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Importando Chart.js para o gráfico -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var ctx = document.getElementById('financeChart').getContext('2d');
    var financeChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio'],
            datasets: [
                {
                    label: 'Receitas',
                    backgroundColor: 'rgba(0, 128, 0, 0.5)',
                    borderColor: 'rgba(0, 128, 0, 1)',
                    borderWidth: 1,
                    data: [5000, 7000, 8000, 6000, 7500]
                },
                {
                    label: 'Despesas',
                    backgroundColor: 'rgba(255, 0, 0, 0.5)',
                    borderColor: 'rgba(255, 0, 0, 1)',
                    borderWidth: 1,
                    data: [3000, 4000, 3500, 4500, 5000]
                }
            ]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>
